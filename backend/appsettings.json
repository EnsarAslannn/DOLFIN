{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "WritePermitLimit": 30,
    "WriteWindowSeconds": 60,
    "ChatPermitLimit": 12,
    "ChatWindowSeconds": 60
  },
  "Chat": {
    "Enabled": false,
    "ApiKey": "",
    "Endpoint": "https://ai-gateway.vercel.sh/v1/chat/completions",
    "Model": "openai/gpt-5.4-mini"
  },
  "Diagnostics": {
    "NPlusOneThreshold": 3
  },
  "PriceAlerts": {
    "Enabled": true,
    "IntervalSeconds": 60
  },
  "PriceSimulation": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "MaxMovePercent": 1.5,
    "MinPrice": 1.0,
    "HistoryRetentionHours": 48
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": "",
  "JWT": {
    "Issuer": "https://dol-fin.com",
    "Audience": "https://dol-fin.com",
    "SigningKey": ""
  },
  "Admin": {
    "SeedUsername": ""
  }
}
