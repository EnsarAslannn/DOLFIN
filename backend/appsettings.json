{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Diagnostics": {
    "NPlusOneThreshold": 3
  },
  "PriceAlerts": {
    "CheckIntervalHours": 24
  },
  "PriceSimulation": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "MaxMovePercent": 1.5,
    "MinPrice": 1.0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [{ "Name": "Console" }]
  },
  "AllowedHosts": "*",
  "AllowedOrigins": "https://dol-fin.com",
  "JWT": {
    "Issuer": "https://dol-fin.com",
    "Audience": "https://dol-fin.com",
    "SigningKey": ""
  },
  "Admin": {
    "SeedUsername": ""
  }
}
