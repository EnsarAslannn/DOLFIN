# DOL-FIN API — environment variable reference
#
# ASP.NET Core's configuration system reads process environment variables
# using `Section__Key` (double underscore) as the nesting separator, which
# is exactly what docker-compose.yml sets under `environment:`. This file
# documents those same keys for anyone running the API outside Docker
# Compose (a plain shell, a `.env` loader, a different container platform).
#
# Locally, prefer `dotnet user-secrets` for anything under Data Protection
# instead of a real .env file — see backend/README.md's Setup section:
#   dotnet user-secrets init
#   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "..."
#   dotnet user-secrets set "JWT:SigningKey" "..."
#
# Copy this file to `.env` only if your runner actually loads .env files
# (docker-compose.yml here does not read one automatically — its values are
# hardcoded dev placeholders). Never commit a real `.env` with production
# values; `.env` is gitignored, `.env.example` is not.

# --- Database (required) ---
# PostgreSQL connection string. Local dev via docker-compose's postgres
# service (see docker-compose.yml):
ConnectionStrings__DefaultConnection=Host=localhost;Database=dolfin;Username=postgres;Password=postgres123

# --- Redis (optional — soft dependency) ---
# Distributed cache. If unset/unreachable the app falls back to direct DB
# reads and /health reports Redis as "Degraded", not "Unhealthy".
ConnectionStrings__Redis=localhost:6379

# --- JWT auth (required) ---
# Signing key must be at least 64 characters/bytes. Never reuse the example
# value below anywhere real — it's the same dev-only placeholder baked into
# docker-compose.yml.
JWT__SigningKey=local-dev-only-signing-key-do-not-use-in-production-64-bytes-minimum-000
JWT__Issuer=https://dol-fin.com
JWT__Audience=https://dol-fin.com

# --- CORS (optional) ---
# Extra origin(s) allowed to call the API from a browser, comma- or
# semicolon-separated, with no trailing slash. These are ADDED to the
# built-in list in Program.cs (dol-fin.com, www.dol-fin.com, the GitHub Pages
# host and the usual localhost dev ports) rather than replacing it, so a
# missing or mistyped value cannot lock the deployed frontend out. Leave it
# empty unless you are serving the frontend from somewhere new.
AllowedOrigins=

# --- Admin bootstrap (optional) ---
# On startup, grants the Admin role to a user with this username if they
# exist and aren't already an Admin. Leave empty to skip.
Admin__SeedUsername=

# --- ASP.NET Core runtime (optional) ---
ASPNETCORE_ENVIRONMENT=Development
PORT=8080

# --- Rate limiting (optional) ---
# Sign-in / sign-up attempts allowed per IP per window.
RateLimiting__AuthPermitLimit=10
RateLimiting__AuthWindowSeconds=60
# Trades, wallet movements and comment writes allowed per *user* per window.
# Partitioned by user id rather than by IP so one office network or mobile
# carrier NAT does not share a single budget between everyone behind it.
RateLimiting__WritePermitLimit=30
RateLimiting__WriteWindowSeconds=60

# --- Price simulation (optional) ---
# The walk that moves prices on a timer, and how long each recorded price is
# kept. History is what the wallet's sparklines are drawn from; without a
# retention window the table grows for as long as the process runs.
PriceSimulation__Enabled=true
PriceSimulation__IntervalSeconds=60
PriceSimulation__HistoryRetentionHours=48
